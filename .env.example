# ==========================================
# HRFlow Production Docker Environment Example
# ==========================================
# Copy this file to .env before running `docker compose up -d`
# All variables below have defaults in docker-compose.yml if omitted.

# Port Mappings
BACKEND_PORT=5000
FRONTEND_PORT=80

# Backend Database Configuration (PostgreSQL via Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/hrflow?schema=public"
DATABASE_URL_UNPOOLED="postgresql://user:password@localhost:5432/hrflow?schema=public"

# Backend Authentication Security
JWT_SECRET=your-secure-jwt-secret-at-least-32-chars-long
JWT_EXPIRES_IN=7d

# Frontend API Endpoint (injected at build time or accessible by client browser)
# - Default for containerized full-stack deployment via Nginx reverse proxy: /api/v1
# - Default for local Vite dev server pointing to separate backend: http://localhost:5000/api/v1
VITE_API_URL=/api/v1
