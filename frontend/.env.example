# ==========================================
# HRFlow Frontend Environment Configuration
# ==========================================
# Copy this file to .env:
#   cp .env.example .env

# Base URL for the HRFlow Backend REST API
# - Local development (without proxy): http://localhost:5000/api/v1
# - Docker / Production behind Nginx reverse proxy: /api/v1
# - Custom domain / Staging / Production: https://api.yourdomain.com/api/v1
VITE_API_URL=http://localhost:5000/api/v1
