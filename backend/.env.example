# ==========================================
# HRFlow Backend Environment Configuration
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL via Prisma)
DATABASE_URL="postgresql://neondb_owner:REDACTED_DATABASE_PASSWORD@ep-summer-hat-aheuyhud-pooler.c-3.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:REDACTED_DATABASE_PASSWORD@ep-summer-hat-aheuyhud.c-3.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Authentication & Security
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Employee Document Management (optional)
# Where multer stages uploads BEFORE they are moved to /uploads/employee-documents/<empId>/.
# Defaults to OS temp dir when unset. Set to ./tmp if you want reproducible local staging.
# UPLOAD_STAGING_DIR=./tmp
