# ==========================================
# HRFlow Backend Environment Configuration
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL via Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/hrflow?schema=public"
DATABASE_URL_UNPOOLED="postgresql://user:password@localhost:5432/hrflow?schema=public"

# Authentication & Security
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Employee Document Management (optional)
# Where multer stages uploads BEFORE they are moved to /uploads/employee-documents/<empId>/.
# Defaults to OS temp dir when unset. Set to ./tmp if you want reproducible local staging.
# UPLOAD_STAGING_DIR=./tmp
